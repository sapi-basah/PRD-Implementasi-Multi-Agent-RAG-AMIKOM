{"chunk_id":"CH-ACA-A01-DOC-A01-ACADEMIC-POLICY-0005","chunk_index":5,"chunk_version":"V1-ea14474c4a26","chunk_type":"POLICY","chunk_text":"2.5.5 MENGIKUTI UJIAN TENGAH DAN UJIAN AKHIR SEMESTER\nUjian Tengah Semester (UTS) dan Ujian Akhir Semester (UAS) merupakan proses evaluasi\nkegiatan belajar mengajar pada masing-masing mata kuliah yang diselenggarakan oleh seluruh\nProgram Studi di lingkungan Universitas Amikom Yogyakarta. Setiap mahasiswa yang mengikuti\nkegiatan perkuliahan wajib mengikuti proses evaluasi tersebut, baik Ujian Tengah Semester maupun\nUjian Akhir Semester. Persyaratan yang harus dipenuhi oleh mahasiswa untuk dapat mengikuti ujian\nadalah sebagai berikut:","token_count":538,"character_count":538,"document_id":"DOC-A01-ACADEMIC","clean_document_id":"CLN-A01-ACADEMIC-001","supporting_clean_document_ids":"NOT_APPLICABLE","source_id":"A01","title":"Buku Panduan Universitas 2025/2026 — Bagian Akademik","section_title":"Tata Tertib Perkuliahan dan UTS/UAS","subsection_title":"2.5.5 MENGIKUTI UJIAN TENGAH DAN UJIAN AKHIR SEMESTER","heading_path":"Buku Panduan Universitas 2025/2026 — Bagian Akademik > Tata Tertib Perkuliahan dan UTS/UAS > 2.5.5 MENGIKUTI UJIAN TENGAH DAN UJIAN AKHIR SEMESTER","table_id":"NOT_APPLICABLE","row_id":"NOT_APPLICABLE","event_id":"NOT_APPLICABLE","procedure_id":"NOT_APPLICABLE","page_start":23,"page_end":24,"source_page":23,"anchor":"NOT_APPLICABLE","locator_text":"<!-- locator: source_id=A01; raw_filename=A01__panduan-universitas__2025-2026__verif1__2026-07-24.pdf; locator_type=PDF_PAGE; pdf_page_start=23; pdf_page_end=24; printed_page_start=15; printed_page_end=16; section=2.5.4-2.5.5 -->","raw_record_ids":"REC-0001","official_url":"https://drive.google.com/file/d/1Cd8S6GOpP47KIPuON125OaHKdOxZEzHa/view?usp=sharing","publisher_unit":"Universitas AMIKOM Yogyakarta / DAAK","academic_year":"2025/2026","semester":"NOT_APPLICABLE","cohort":"2025","agent_namespace":"academic","mapped_agent_namespaces":"academic","retrieval_namespac