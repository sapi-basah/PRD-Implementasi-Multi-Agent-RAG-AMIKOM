{"chunk_id":"CH-ADM-A01-DOC-A01-ADMIN-ADMIN_POLICY-0002","chunk_index":2,"chunk_version":"V1-b03c63a93407","chunk_type":"ADMIN_POLICY","chunk_text":"2.6.1 PENGISIAN KARTU RENCANA STUDI (KRS)\n\nPada saat memasuki semester baru, setiap mahasiswa diharuskan menetapkan program belajarnya untuk satu semester berjalan. Program belajar semester ini harus didaftarkan agar mahasiswa yang bersangkutan diizinkan mengikuti kegiatan belajar mengajar yang terdiri atas sesi perkuliahan tatap muka, studio, dan konsultasi skripsi. Program belajar mahasiswa ini dibuat dalam bentuk kartu yang disebut Kartu Rencana Studi (KRS).","token_count":465,"character_count":465,"document_id":"DOC-A01-ADMIN","clean_document_id":"CLN-A01-ADMIN-001","supporting_clean_document_ids":"NOT_APPLICABLE","source_id":"A01","title":"Buku Panduan Universitas 2025/2026 — Bagian Administrasi","section_title":"Pengisian Kartu Rencana Studi (KRS) — ketentuan D-3/S-1","subsection_title":"2.6.1 PENGISIAN KARTU RENCANA STUDI (KRS)","heading_path":"Buku Panduan Universitas 2025/2026 — Bagian Administrasi > Pengisian Kartu Rencana Studi (KRS) — ketentuan D-3/S-1 > 2.6.1 PENGISIAN KARTU RENCANA STUDI (KRS)","table_id":"NOT_APPLICABLE","row_id":"NOT_APPLICABLE","event_id":"NOT_APPLICABLE","procedure_id":"NOT_APPLICABLE","page_start":37,"page_end":37,"source_page":37,"anchor":"NOT_APPLICABLE","locator_text":"<!-- locator: source_id=A01; raw_filename=A01__panduan-universitas__2025-2026__verif1__2026-07-24.pdf; locator_type=PDF_PAGE; pdf_page_start=37; pdf_page_end=37; printed_page_start=29; printed_page_end=29; section=2.6.1 -->","raw_record_ids":"REC-0001","official_url":"https://drive.google.com/file/d/1Cd8S6GOpP47KIPuON125OaHKdOxZEzHa/view?usp=sharing","publisher_unit":"Universitas AMIKOM Yogyakarta / DAAK","academic_year":"2025/2026","semester":"NOT_APPLICABLE","cohort":"2025","agent_namespace":"administration","mapped_agent_namespaces":"administration","retrieval_namespace":"active_administration","lifecycle_status